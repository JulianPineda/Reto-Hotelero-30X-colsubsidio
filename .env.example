# ============================================================
# ENVIRONMENT VARIABLES — Reto Piscilago 30x
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Database ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=inventory_db
DATABASE_URL=postgresql+asyncpg://inventory:change_me_in_production@postgres:5432/inventory_db

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=catalog_items

# --- Gemini 1.5 Flash (Voice STT/Live API + Parser NER + Auditor Explainer) ---
# ADR-001 (CLAUDE.md §1.1): reemplaza OpenAI Realtime + Claude Haiku por un único proveedor.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- JWT Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_random_256_bit_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Export File Storage ---
# Absolute path inside the backend container
EXPORT_BASE_DIR=/app/exports

# --- CORS (comma-separated list — NO wildcards) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# --- STT Thresholds (calibrate in field) ---
STT_CONFIDENCE_THRESHOLD=0.75
ANOMALY_HISTORY_WINDOW=5

# --- Frontend (build-time Vite vars) ---
VITE_API_BASE_URL=http://localhost/api/v1
VITE_WS_BASE_URL=ws://localhost/ws

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
